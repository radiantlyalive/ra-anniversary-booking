# Copy to .env for local work. Never commit real values. In production these live in
# Netlify > Site configuration > Environment variables, nowhere else.

# mock | sandbox | live. "mock" needs no keys at all.
BOOKING_MODE=mock

# Public origin of the Squarespace site, for CORS (no trailing slash)
ALLOWED_ORIGIN=https://www.radiantlyalive.com

# Momence (API client + the booking-page staff login)
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_HOST_ID=
MOMENCE_WEBHOOK_SECRET=

# Stripe (sandbox key while building; restricted live key later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Klaviyo private API key
KLAVIYO_PRIVATE_KEY=

# Signs reconfirm links so they cannot be guessed (long random string)
RECONFIRM_LINK_SECRET=

# Spam protection (only if Turnstile is approved)
TURNSTILE_SECRET_KEY=
