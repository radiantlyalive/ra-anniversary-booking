# Copy to .env for local work. Never commit real values. In production these are set as
# secrets on the host (Cloudflare Workers secrets once the move is done), nowhere else.

# mock | sandbox | live. "mock" needs no keys at all.
BOOKING_MODE=mock

# Public origin of the Squarespace site, for CORS (no trailing slash)
ALLOWED_ORIGIN=
# Public base URL of this service, used in reconfirm links
PUBLIC_BASE_URL=

# Momence (API client + the booking-page staff login)
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_WEBHOOK_SECRET=  # from the Momence webhook dashboard

# Stripe (sandbox key while building; restricted live key later, Checkout Sessions only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Klaviyo private API key
KLAVIYO_PRIVATE_KEY=

# Signs reconfirm links so they cannot be guessed (long random string)
RECONFIRM_LINK_SECRET=

# Cloudflare Turnstile (only if approved; the site key goes in the embed, not here)
TURNSTILE_SECRET_KEY=

# Optional: GTM container for the standalone reconfirm page
GTM_CONTAINER_ID=
