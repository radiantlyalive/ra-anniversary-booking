{
  "name": "ra-anniversary-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Booking widget and Cloudflare Worker for the Radiantly Alive anniversary, 1 December 2026.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "node scripts/build.mjs",
    "dev": "wrangler dev --port 8888",
    "pretest": "node scripts/build.mjs",
    "test": "BOOKING_MODE=mock node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/widget.e2e.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:momence": "node scripts/momence-checks.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
