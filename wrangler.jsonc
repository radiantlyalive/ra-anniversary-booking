{
  // Cloudflare Worker for the RA anniversary booking. Local only until Rafa and Haidar approve a deploy.
  "name": "ra-anniversary-booking",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"], // node:crypto, Buffer, and process.env filled from vars and secrets
  "build": { "command": "node scripts/build.mjs" },
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"], "html_handling": "none" }, // serve files exactly as named, no .html redirects
  "vars": { "BOOKING_MODE": "mock" }, // secrets are added with `wrangler secret put`, never here
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "RaStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaStore"] }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
